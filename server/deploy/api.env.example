# /etc/next-step-rad/api.env  (Besitzer root:nextstep-api, Rechte 0640)

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Passwort bewusst NICHT in der URL: Base64-Passwörter enthalten oft / oder +,
# die in einer URL kodiert werden müssten. node-postgres liest PGPASSWORD selbst.
DATABASE_URL=postgresql://nextstep_app@127.0.0.1:5432/nextstep
PGPASSWORD=HIER_DAS_PASSWORT_AUS_VAULTWARDEN

# Nur Requests von dieser Adresse dürfen schreiben (CSRF-Schutz).
ALLOWED_ORIGINS=https://nextstep.icf-essen.de

# Optional
# SESSION_DAYS=30
# LOG_LEVEL=info

# Links zu Impressum und Datenschutzerklärung (erscheinen in der App; nur https)
LEGAL_IMPRINT_URL=
LEGAL_PRIVACY_URL=

# Öffentliche Adresse der App (für Rücksprünge nach dem SSO-Login und Reset-Links)
PUBLIC_URL=https://nextstep.icf-essen.de

# --- Anmeldung über Authentik (OIDC) -------------------------------------
# Ohne OIDC_ISSUER ist SSO abgeschaltet. Die Issuer-URL exakt so wie in
# Authentik angezeigt übernehmen, inklusive abschließendem Schrägstrich.
OIDC_ISSUER=https://auth.icf-essen.de/application/o/next-step-rad/
OIDC_CLIENT_ID=HIER_CLIENT_ID_AUS_AUTHENTIK
OIDC_CLIENT_SECRET=HIER_CLIENT_SECRET_AUS_VAULTWARDEN

# Optional (hier mit Standardwerten). Hinweis: systemd erlaubt keine Kommentare
# am Zeilenende, deshalb stehen die Erklärungen jeweils darüber.
# OIDC_SCOPES=openid email profile nextstep_groups
# OIDC_GROUPS_CLAIM=nextstep_groups
#
# Welche Authentik-Gruppen zu Team-Gruppen werden (regulärer Ausdruck):
# OIDC_TEAM_GROUP_PATTERN=-team$
# Wer in "<team>-leitung" ist, leitet das Team:
# OIDC_LEADER_SUFFIX=-leitung
# Nur diese Authentik-Gruppe darf sich per SSO anmelden (leer = alle):
# OIDC_REQUIRED_GROUP=
# Wer in dieser Authentik-Gruppe ist, bekommt bei SSO-Anmeldung die Verwaltung:
# OIDC_ADMIN_GROUP=next-step-admin
# Gültigkeit von Links zum Zurücksetzen des Passworts in Stunden:
# PASSWORD_RESET_HOURS=24
# Sitzungsdauer nach SSO-Login in Tagen:
# OIDC_SESSION_DAYS=7
# OIDC_BUTTON_LABEL=Mit ICF-Konto anmelden

# --- E-Mail (Bestätigung, Passwort vergessen) -------------------------------
# Ohne SMTP_HOST ist keine Registrierung möglich. Versand über das interne
# Mail-Relay (VM 106). IP-Adresse statt Name, dann braucht die API kein DNS.
SMTP_HOST=IP_DES_MAIL_RELAYS
SMTP_PORT=25
MAIL_FROM="Next Step <noreply@icf-essen.de>"
# Bietet das Relay STARTTLS mit selbstsigniertem Zertifikat an, auf false setzen:
# SMTP_TLS_VERIFY=true
# Gültigkeit des Bestätigungslinks in Stunden:
# EMAIL_VERIFY_HOURS=48

# --- Break-Glass (lokale Admins ohne Authentik) -----------------------------
# Schlüssel für die TOTP-Geheimnisse. Erzeugen: openssl rand -base64 32
# Sicher in Vaultwarden ablegen – ohne ihn sind eingerichtete Codes wertlos.
APP_SECRET_KEY=
# Nur aus diesen Netzen lässt sich Break-Glass freischalten (CIDR, kommagetrennt).
# Ohne Angabe ist Break-Glass gesperrt.
ADMIN_LOCAL_NETWORKS=NETZ_1/PRAEFIX,NETZ_2/PRAEFIX
# Höchstdauer einer Freischaltung in Stunden:
# BREAKGLASS_HOURS=8
# Diese Adresse bekommt bei jeder Freischaltung eine Mail (empfohlen):
# BREAKGLASS_NOTIFY_EMAIL=it@icf-essen.de
